.program i2s_microphone_mono_24
.side_set 1        ; BCLK pin

.wrap_target
    set pins, 0        side 0      ; [1] WS Low (Left Channel starts), BCLK=0
    nop                side 1      ; [2] I2S 1-bit delay part 1, BCLK=1
    set x, 23          side 0      ; [3] I2S 1-bit delay part 2, BCLK=0
left_bitloop:
    in pins, 1         side 1      ; [4-51] Sample 24 bits of audio on BCLK high
    jmp x-- left_bitloop side 0    ; Total loop takes 48 instructions
    
    set x, 5           side 1      ; [52] Prepare padding loop, BCLK=1
left_padding:
    nop                side 0      ; [53-64] 6 iterations of 2 instructions = 12 total
    jmp x-- left_padding side 1    ; Left phase ends exactly on instruction 64 (BCLK=1)

    set pins, 1        side 0      ; [1] WS High (Right Channel starts), BCLK=0
    set x, 30          side 1      ; [2] Prepare to skip 32 bits, BCLK=1
right_ignore_loop:
    nop                side 0      ; [3-64] 31 iterations of 2 instructions = 62 total
    jmp x-- right_ignore_loop side 1 ; Right phase ends exactly on instruction 64 (BCLK=1)
.wrap

% c-sdk {
static inline void i2s_microphone_mono_24_program_init(
    PIO pio,
    uint sm,
    uint offset,
    uint bclk_pin,
    uint data_pin
) {
    uint ws_pin = bclk_pin + 1;
    
    // Fixed: Added 'pio' as the first argument
    pio_gpio_init(pio, bclk_pin);
    pio_gpio_init(pio, ws_pin);
    pio_gpio_init(pio, data_pin);

    pio_sm_set_consecutive_pindirs(pio, sm, bclk_pin, 2, true);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, false); 

    pio_sm_config c = i2s_microphone_mono_24_program_get_default_config(offset);
    
    sm_config_set_sideset_pins(&c, bclk_pin);
    sm_config_set_set_pins(&c, ws_pin, 1);
    sm_config_set_in_pins(&c, data_pin);

    // Shift in MSB first (false), autopush (true) at 24 bits
    sm_config_set_in_shift(&c, false, true, 24);

    sm_config_set_clkdiv(&c, 32.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}